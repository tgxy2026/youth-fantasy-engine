# 依赖与构建产物
node_modules/
dist/
dist-web/
dist.oldbak*/
# 构建时临时移开/另开的输出目录（safe-delete 环境下 emptyOutDir 需绕行）
dist-web-*/
dist-web.bak-*/
dist_bak_*/
web-build-*/
*.tsbuildinfo

# 封装输出
release/
# build/ 只放 electron-builder 图标源与自定义 NSIS 片段：忽略目录内容但这两者必须入库
#   （否则换机 clone 会丢安装图标、以及安装器的安装目录自愈逻辑）
build/*
!build/icon.ico
!build/installer.nsh

# 图标设计草稿（AI 生成候选图，定稿应用后清理）
icon-drafts/

# 测试打包产物（esbuild 转译后的运行包，非源码）
tests/.roundtrip.mjs
tests/.*.mjs

# 系统杂项
Thumbs.db
Desktop.ini
*.log

# 临时脚本与中间产物（审计/修复用的一次性补丁器、报告草稿）
.workbuddy/tmp/
#   一次性临时目录（如跑团验证用的浏览器 userdata：tmp-w42/ —— 含上千缓存文件，绝不入库）
.workbuddy/tmp-*/
#   审计报告草稿与 HTML（过程产物，非产品源码）
.workbuddy/audit-*/
#   便携版免安装改造的过程产物：方案评估 / 实施记录 / 构建原型与验证脚本
.workbuddy/portable-sea/
#   需求评估报告（对用户反馈的分析结论，属过程产物，非产品源码）
.workbuddy/evals/

# 🔴 便携版运行时数据目录 —— 里面是作者的全部稿件，绝不进版本库。
#    在源码根目录跑 `npm run start:portable` 会生成 ./data/（含整库 JSON 与 .port 锁）；
#    不排除的话 `git add -A` 会把整部小说连带提交上去（2026-10-11 审计发现）。
/data/

# 工作记录与本地工具 —— 不进版本库：
#   memory/ 是 AI 的工作日志与长期记忆（非产品源码，历史提交已确认一律不带）
#   tools/  含与本项目无关的脚本（如战锤截图），只在本机用
.workbuddy/memory/
.workbuddy/tools/
#   automations/ 是自动化任务的执行记忆（含运维细节 / 访客 IP 等，绝不入库）
.workbuddy/automations/
#   .workbuddy 下其余散件（一次性脚本如 process-bg.py 等）一律不进
.workbuddy/*.py
dist-verify-*/
