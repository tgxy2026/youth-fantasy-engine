{
  "name": "novel-studio",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "青春幻想引擎 · 小说创作管理 Web 应用（便携版 + Windows 桌面版）",
  "author": "青春幻想引擎开发组",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5199",
    "build": "tsc && vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "build:portable": "node scripts/make-portable.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "electron:dev": "vite --port 5199 & ELECTRON_START_URL=http://localhost:5199 electron .",
    "preview": "vite preview --port 5199",
    "cleanup": "node scripts/cleanup-residual.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "idb": "^8.0.0",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
