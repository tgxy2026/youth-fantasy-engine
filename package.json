{
  "name": "youth-fantasy-engine",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "description": "青春幻想引擎 · 把世界观、角色、大纲、正文串成一条线的长篇创作工作台（桌面版 Windows / 便携版 / 网页版）",
  "author": "青春幻想引擎开发组",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5199",
    "build": "tsc && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:portable": "tsc && vite build",
    "build:portable-pkg": "node scripts/build-portable-pkg.mjs",
    "start:portable": "node scripts/portable-server.mjs",
    "electron:dev": "vite --port 5199 & ELECTRON_START_URL=http://localhost:5199 electron .",
    "preview": "vite preview --port 5199",
    "test": "node tests/run-all.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "verify": "npm run typecheck && npm run lint && npm test",
    "cleanup": "node scripts/cleanup-residual.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.400.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.3"
  },
  "overrides": {
    "@eslint/config-array": {
      "brace-expansion": "^1.1.21"
    },
    "@eslint/eslintrc": {
      "brace-expansion": "^1.1.21"
    },
    "eslint": {
      "brace-expansion": "^1.1.21"
    },
    "http-cache-semantics": "^4.3.0"
  }
}
