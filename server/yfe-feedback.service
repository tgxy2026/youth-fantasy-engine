[Unit]
Description=YFE Web Feedback Service
After=network.target

[Service]
# 入门访问邀请码列表（逗号分隔）。可随时增删，重启服务即生效。
# 入门邀请码仅用于「进入网页版」，不区分用户；分发时请人工记录防止重复外发（见 docs/邀请码分发记录.md）。
Environment=INVITE_CODES=YFE-D49E-6MPG,YFE-UEFN-NA4L,YFE-RLJC-JTMV,YFE-RCVL-SRJG,YFE-4P7Q-C32L,YFE-WXLL-GWDD,YFE-QUXD-LVBD,YFE-UEKF-WSDU,YFE-5LAU-BHXS,YFE-UKZT-VF24,YFE-XAJ4-N5KE,YFE-7JAN-XAAY,YFE-K8UU-W3MH,YFE-AR8C-AGDW,YFE-ZQQP-K2NJ,YFE-PV7Q-JSXR,YFE-W5M8-7DT5,YFE-G8XN-M2VN,YFE-P7UB-82D5,YFE-NPDC-LTXM
# 云端同步特权专属邀请码（#003）：与 INVITE_CODES 独立。每个码对应一个独立云端槽位，
# 请勿多人共用同一同步码（会互相覆盖数据）。共 20 个。
Environment=SYNC_CODES=YFE-SYNC-7Q3K-2X9M,YFE-SYNC-N6SV-2YZJ,YFE-SYNC-86Y6-JZGD,YFE-SYNC-QZ5M-USVK,YFE-SYNC-PZTA-VJTP,YFE-SYNC-X27Q-G6Z7,YFE-SYNC-3XQK-8KH3,YFE-SYNC-KWBN-WXSV,YFE-SYNC-S8E3-94XV,YFE-SYNC-MDUK-PALY,YFE-SYNC-2MPW-5PBW,YFE-SYNC-7SGU-X4YL,YFE-SYNC-UCU4-928P,YFE-SYNC-MR5A-XBN6,YFE-SYNC-YCCD-CRKF,YFE-SYNC-J3UQ-BCRE,YFE-SYNC-FG5W-RX6H,YFE-SYNC-DHLY-EFVV,YFE-SYNC-QLRR-XPTM,YFE-SYNC-W9K7-52PF
# #026：单文件闸按码配额。普通同步码 SYNC_LIMIT_MB=50；ADMIN_SYNC_CODES 名单内走 ADMIN_SYNC_LIMIT_MB=450（老大的码）。
Environment=SYNC_LIMIT_MB=50
Environment=ADMIN_SYNC_CODES=YFE-SYNC-7Q3K-2X9M
Environment=ADMIN_SYNC_LIMIT_MB=450
Environment=FEEDBACK_DIR=/var/lib/yfe
Environment=FEEDBACK_PORT=3000
WorkingDirectory=/opt/yfe-server
ExecStart=/usr/bin/node /opt/yfe-server/feedback-server.mjs
Restart=on-failure
User=www-data

[Install]
WantedBy=multi-user.target
