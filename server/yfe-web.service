[Unit]
Description=Youth Fantasy Engine Web (static + api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/yfe/server
ExecStart=/usr/bin/node /opt/yfe/server/index.mjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=YFE_WWW=/opt/yfe/www
Environment=PORT=80
# 机器只有 1.7 GB 内存：给单个服务设上限，异常时被 OOM 杀掉的是它而不是整台机器
MemoryMax=512M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
